# ── Genel ─────────────────────────────────────────────────────────────────────
* text=auto eol=lf

# ── Unity YAML (Smart Merge) ──────────────────────────────────────────────────
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.meta merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.mask merge=unityyamlmerge eol=lf
*.playable merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf
*.shadergraph merge=unityyamlmerge eol=lf
*.shadersubgraph merge=unityyamlmerge eol=lf

# ── Kod ───────────────────────────────────────────────────────────────────────
*.cs diff=csharp text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# ── Git LFS ───────────────────────────────────────────────────────────────────
# Mevcut asset'ler repoda normal Git'te. LFS'e geçmeden önce bu satırları
# açma — yoksa tüm PNG/audio "modified" görünür.
# Migration sonrası: git lfs migrate import ... → sonra aşağıyı uncomment et.
#
# *.png filter=lfs diff=lfs merge=lfs -text
# *.jpg filter=lfs diff=lfs merge=lfs -text
# ... (scripts/setup-unity-git.sh ve docs'a bak)
